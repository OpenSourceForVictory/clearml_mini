# Four-role Compose defaults now match this tested profile; keep this example for
# explicit overrides on older deployments. PostgreSQL max_connections >= 200.
API_DB_PROCESS_COUNT=12
DB_CONNECTION_HEADROOM=20
PRIORITY_API_ADMISSION_LIMITS='{"execution_control":20,"user_action":6,"user_long":2,"page_read":12,"worker_claim":10,"worker_result":12,"worker_observation":12,"bulk_transfer":12}'
PRIORITY_API_QUEUE_LIMITS='{"execution_control":80,"user_action":80,"user_long":24,"page_read":160,"worker_claim":40,"worker_result":48,"worker_observation":128,"bulk_transfer":192}'
PRIORITY_API_QUEUE_WAITS='{"execution_control":1,"user_action":2,"user_long":3,"page_read":3,"worker_claim":0.5,"worker_result":0.5,"worker_observation":1,"bulk_transfer":2}'
PRIORITY_API_POOL_WAITS='{"execution_control":1,"user_action":1,"user_long":1,"page_read":3,"worker_claim":0.5,"worker_result":0.5,"worker_observation":0.5,"bulk_transfer":0.5}'
PRIORITY_API_REQUEST_BUDGETS='{"user_action":12,"page_read":12,"user_long":30}'
PRIORITY_API_POOL_SIZES='{"execution_control":12,"user_action":3,"user_long":1,"page_read":10,"worker_claim":6,"worker_result":7,"worker_observation":8,"scheduler":1,"bulk_transfer":10}'
DB_CONNECTION_BUDGET=180
