{
  "routes": [
    {
      "method": "POST",
      "path": "/api/v1/worker/executions/{execution_id}/recovery/control",
      "category": "execution_control",
      "role": "execution-control",
      "body": [
        {
          "name": "body",
          "required": true,
          "schema": "<class 'backend.app.recovery_records.ControlRecord'>"
        }
      ],
      "confirmation": "state/lease confirmation; retry original execution identity",
      "source": "backend.app.recovery_records.control"
    },
    {
      "method": "POST",
      "path": "/api/v1/worker/executions/{execution_id}/recovery/results",
      "category": "worker_result",
      "role": "worker-data",
      "body": [
        {
          "name": "body",
          "required": true,
          "schema": "<class 'backend.app.recovery_records.ResultRecord'>"
        }
      ],
      "confirmation": "reliable result acknowledgement; duplicate content must match",
      "source": "backend.app.recovery_records.results"
    },
    {
      "method": "POST",
      "path": "/api/v1/worker/executions/{execution_id}/recovery/reconcile",
      "category": "execution_control",
      "role": "execution-control",
      "body": [
        {
          "name": "body",
          "required": true,
          "schema": "<class 'backend.app.recovery_control.Observation'>"
        }
      ],
      "confirmation": "state/lease confirmation; retry original execution identity",
      "source": "backend.app.recovery_control.control"
    },
    {
      "method": "POST",
      "path": "/api/v1/worker/slots/{slot_id}/recovery/claim",
      "category": "execution_control",
      "role": "execution-control",
      "body": [
        {
          "name": "body",
          "required": true,
          "schema": "<class 'backend.app.recovery_claims.Lookup'>"
        }
      ],
      "confirmation": "state/lease confirmation; retry original execution identity",
      "source": "backend.app.recovery_claims.recover_claim"
    },
    {
      "method": "POST",
      "path": "/api/v1/worker/executions/{execution_id}/recovery/prepare",
      "category": "execution_control",
      "role": "execution-control",
      "body": [
        {
          "name": "body",
          "required": true,
          "schema": "<class 'backend.app.recovery_launch.LaunchRequest'>"
        }
      ],
      "confirmation": "state/lease confirmation; retry original execution identity",
      "source": "backend.app.recovery_launch.prepare_launch"
    },
    {
      "method": "POST",
      "path": "/api/v1/worker/executions/{execution_id}/recovery/results-finished",
      "category": "worker_result",
      "role": "worker-data",
      "body": [
        {
          "name": "body",
          "required": true,
          "schema": "<class 'backend.app.execution.RecoveryProof'>"
        }
      ],
      "confirmation": "reliable result acknowledgement; duplicate content must match",
      "source": "backend.app.execution.results_finished"
    },
    {
      "method": "POST",
      "path": "/api/v1/worker/executions/{execution_id}/recovery/not-started",
      "category": "execution_control",
      "role": "execution-control",
      "body": [
        {
          "name": "body",
          "required": true,
          "schema": "<class 'backend.app.recovery_unstarted.NotStarted'>"
        }
      ],
      "confirmation": "state/lease confirmation; retry original execution identity",
      "source": "backend.app.recovery_unstarted.not_started"
    }
  ],
